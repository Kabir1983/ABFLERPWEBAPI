                    var objDMSRWSTIData = _dbContext.DmsRouteWiseSalesTargetIncs.FirstOrDefault(m => m.RouteID == objDmsRouteWiseSalesTargetInc.RouteID && m.SRID == objDmsRouteWiseSalesTargetInc.SRID && m.STGID == objDmsRouteWiseSalesTargetInc.STGID && m.STTID == objDmsRouteWiseSalesTargetInc.STTID);
                    if (objDMSRWSTIData == null)
                    {
                        long maxFPBID = _dbContext.DmsRouteWiseSalesTargetIncs.Max(m => (long?)m.ID) ?? 0;
                        objDmsRouteWiseSalesTargetInc.ID = maxFPBID + 1;
                        objDmsRouteWiseSalesTargetInc.LastUpdate = DateTime.Now;
                        objDmsRouteWiseSalesTargetInc.CreateDate = DateTime.Now;
