                        objDMSRWSTIDataO.MemoTarget = objDmsRouteWiseSalesTargetInc.MemoTarget;
                        objDMSRWSTIDataO.TotalSales = objDmsRouteWiseSalesTargetInc.TotalSales;
                        objDMSRWSTIDataO.TotalMemo = objDmsRouteWiseSalesTargetInc.TotalMemo;
                        objDMSRWSTIDataO.AverageSales = objDmsRouteWiseSalesTargetInc.AverageSales;
                        objDMSRWSTIDataO.AverageMemo = objDmsRouteWiseSalesTargetInc.AverageMemo;
                        objDMSRWSTIDataO.Category = objDmsRouteWiseSalesTargetInc.Category;
                        objDMSRWSTIDataO.STPID = objDmsRouteWiseSalesTargetInc.STPID;
                        objDMSRWSTIDataO.LastUpdate = DateTime.Now;
                        _dbContext.DmsRouteWiseSalesTargetIncs.Update(objDMSRWSTIDataO);
                    }
                }
            }
            if (_dbContext.SaveChanges() > 0)
            {
                response.StatusCode = 200;
                response.StatusMessage = "Save Success";
