        [HttpGet]
        public async Task<IActionResult> GetMKTTourPlans()
        {
            return Ok(await _dbContext.MKTTourPlans.ToListAsync());
        }

        [HttpGet("GetMKTTourPlansByID")]
        public async Task<IActionResult> GetMKTTourPlansByID(int MKTTourPlanID, string MKTTourPlanName)
        {
            var MKTTourPlanData = _dbContext.MKTTourPlans.FromSqlRaw($"GetMKTTourPlanByID @MKTTourPlanID={MKTTourPlanID}, @MKTTourPlanName='{MKTTourPlanName}' ").ToListAsync();
            return Ok(await MKTTourPlanData);
        }

