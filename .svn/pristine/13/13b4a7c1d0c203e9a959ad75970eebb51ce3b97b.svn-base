        [HttpPost]
        [Route("PostTourPlans")]
        public async Task<IActionResult> SaveTourPlans([FromBody] List<MKTTourPlan> tourPlans)
        {
            if (tourPlans == null || !tourPlans.Any())
            {
                return BadRequest("Invalid or empty tour plan list.");
            }

            try
            {
                long maxID = await _dbContext.MKTTourPlans.MaxAsync(m => (long?)m.ID) ?? 0;

                foreach (var plan in tourPlans)
                {
                    maxID++; // Increment ID manually if no identity column
                    var existPlan = await _dbContext.MKTTourPlans.FirstOrDefaultAsync(m => m.Date == plan.Date && m.OutletID == plan.OutletID);
                    if (existPlan == null)
                    {
                        MKTTourPlan objMKTTourPlan = new MKTTourPlan
                        {
                            ID = maxID,
                            EmploymentID = plan.EmploymentID,
                            RouteID = plan.RouteID,
                            RouteTypeID = plan.RouteTypeID,
                            RouteType = plan.RouteType,
                            RouteDistance = plan.RouteDistance,
                            ClusterID = plan.ClusterID,
                            OutletID = plan.OutletID,
                            OutletName = plan.OutletName,
                            Date = plan.Date,
                            VisitStatus = plan.VisitStatus,
                            VehicleTypeID = plan.VehicleTypeID,
                            VehicleType = plan.VehicleType,
                            ApprovedByID = 0,
                            ApprovedStatus = false,
                            IsActive = plan.IsActive,
                            LastUpdate = plan.LastUpdate
                        };
                        await _dbContext.MKTTourPlans.AddAsync(objMKTTourPlan);
                    }
                }

                await _dbContext.SaveChangesAsync();

                return Ok(new
                {
                    Message = "Tour Plans Created Successfully",
                    StatusCode = "200",
                    TotalInserted = tourPlans.Count
                });
            }
            catch (Exception ex)
            {
                return StatusCode(500, new
                {
                    Message = "Internal Server Error",
                    Details = ex.Message,
                    StatusCode = "500"
                });
            }
        }


