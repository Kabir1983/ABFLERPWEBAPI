        [HttpPost]
        [Route("PostOutletVisit")]
        public async Task<IActionResult> SaveOutletVisits([FromBody] OutletVisit outletVisit)
        {
            if (outletVisit == null)
            {
                return BadRequest("Invalid or empty outlet visit.");
            }

            try
            {
                long maxID = await _dbContext.MKTOutletVisits.MaxAsync(m => (long?)m.ID) ?? 0;
                long maxOVDID = await _dbContext.MKTOutletVisitDetailss.MaxAsync(m => (long?)m.ID) ?? 0;

                MKTOutletVisit objMktOutletVisit = new MKTOutletVisit();

                objMktOutletVisit.ID = ++maxID;
                objMktOutletVisit.OutletID = outletVisit.OutletID;
                objMktOutletVisit.OutletName = outletVisit.OutletName;
                objMktOutletVisit.TourPlanID = outletVisit.TourPlanID;
                objMktOutletVisit.Date = outletVisit.Date;
                objMktOutletVisit.RouteID = outletVisit.RouteID;
                objMktOutletVisit.ClusterID = outletVisit.ClusterID;
                objMktOutletVisit.ContactNo = outletVisit.ContactNo;
                objMktOutletVisit.IsActive = true;
                objMktOutletVisit.LastUpdate = DateTime.Now;
                objMktOutletVisit.Latitude = Math.Round(outletVisit.Latitude ?? 0, 7);
                objMktOutletVisit.Longitude = Math.Round(outletVisit.Longitude ?? 0, 7);

                await _dbContext.MKTOutletVisits.AddAsync(objMktOutletVisit);

                if (objMktOutletVisit.OutletID > 0)
                {
                    var objOutlet = await _dbContext.SetOutlets.FirstOrDefaultAsync(m => m.OutletId == objMktOutletVisit.OutletID && m.Latitude == null);
                    if (objOutlet != null)
                    {
                        objOutlet.Latitude = Math.Round(outletVisit.Latitude ?? 0, 7);
                        objOutlet.Longitude = Math.Round(outletVisit.Longitude ?? 0, 7);
                        objOutlet.GPSAddress = outletVisit.GPSAddress;
                    }
                }

                if (outletVisit.Details.Count > 0)
                {
                    foreach (var plan in outletVisit.Details)
                    {

                        MKTOutletVisitDetails objMKTOutletVisitDetails = new MKTOutletVisitDetails
                        {
                            ID = ++maxOVDID,
                            OVID = maxID,
                            ParameterID = plan.ParameterID,
                            VerifyStatus = plan.VerifyStatus,
                            IsActive = true,
                            LastUpdate = DateTime.Now,
                        };
                        await _dbContext.MKTOutletVisitDetailss.AddAsync(objMKTOutletVisitDetails);
                    }
                    await _dbContext.SaveChangesAsync();
                }

                return Ok(new
                {
                    Message = "Outlet Visit Created Successfully",
                    StatusCode = "200",
                    TotalInserted = outletVisit.Details.Count
                });
            }
            catch (Exception ex)
            {
                return StatusCode(500, new
                {
                    Message = "Internal Server Error",
                    Details = ex.Message,
                    StatusCode = "500"
                });
            }
        }


