        }

        [HttpGet("GetMKTOutletVisitsByID")]
        public async Task<IActionResult> GetMKTOutletVisitsByID(int MKTOutletVisitID, string MKTOutletVisitName)
        {
            var MKTOutletVisitData = _dbContext.MKTOutletVisits.FromSqlRaw($"GetMKTOutletVisitByID @MKTOutletVisitID={MKTOutletVisitID}, @MKTOutletVisitName='{MKTOutletVisitName}' ").ToListAsync();
            return Ok(await MKTOutletVisitData);
        }

